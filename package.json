{
  "name": "tshirt-automation",
  "version": "1.0.0",
  "description": "Bulk-place a design onto t-shirt mockup photos with perspective-correct warping",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.tshirtautomation.app",
    "productName": "T-Shirt Bulk Placement",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/canvas/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
